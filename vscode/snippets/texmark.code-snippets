{
  "Theorem": {
    "prefix": [
      "thm"
    ],
    "body": [
      "::: theorem [${1:Title}] {#thm:${2:label}}",
      "$0",
      ":::"
    ],
    "description": "Theorem block, numbered, with a title and a label (delete what you do not need)"
  },
